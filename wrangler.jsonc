{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shams-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Workers Builds currently runs "npm run build" then "npx wrangler deploy".
  // Produce the OpenNext Worker during Wrangler's deploy/build step, reusing
  // the .next output created by the preceding Next.js build.
  "build": {
    "command": "npm run build:worker"
  }
}
